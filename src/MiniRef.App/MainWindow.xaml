<Window x:Class="MiniRef.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MiniRef.App"
        xmlns:views="clr-namespace:MiniRef.App.Views"
        xmlns:models="clr-namespace:MiniRef.Core.Models;assembly=MiniRef.Core"
        xmlns:conv="clr-namespace:MiniRef.App.Converters"
        xmlns:vm="clr-namespace:MiniRef.App.ViewModels"
        mc:Ignorable="d"
        Title="MiniMax H3 Reference Prompt Composer" Height="900" Width="1400"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:IndexPlusOneConverter x:Key="IndexPlusOne"/>
        <conv:PathToFileNameConverter x:Key="PathToFileName"/>
        <conv:BlankStringToVisibilityConverter x:Key="BlankStringToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PlaceholderOverlayStyle" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="8,4,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Padding="10,4" Command="{Binding NewProjectCommand}"/>
                <Button Content="Open..." Padding="10,4" Margin="6,0,0,0" Command="{Binding OpenProjectCommand}"/>
                <Button Content="Save" Padding="10,4" Margin="6,0,0,0" Command="{Binding SaveProjectCommand}"/>
                <Button Content="Save As..." Padding="10,4" Margin="6,0,0,0" Command="{Binding SaveProjectAsCommand}"/>
                <ToggleButton x:Name="ProjectSwitcherToggle" Padding="10,4" Margin="20,0,0,0"
                              VerticalAlignment="Center" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Project.Name}" FontWeight="Bold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" ▾" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Popup PlacementTarget="{Binding ElementName=ProjectSwitcherToggle}" Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=ProjectSwitcherToggle, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                            MinWidth="280" Margin="0,2,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <ItemsControl ItemsSource="{Binding OpenProjects}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" CornerRadius="3" Margin="0,1"
                                                Background="Transparent" MouseLeftButtonUp="ProjectRow_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="✕" Width="20" Padding="0" Margin="4,0,0,0"
                                                        Click="CloseProjectTab_Click" ToolTip="Close this project"/>
                                                <Button DockPanel.Dock="Right" Content="✎" Width="20" Padding="0"
                                                        Click="EditProjectName_Click" ToolTip="Rename this project"/>
                                                <TextBlock DockPanel.Dock="Left" Text="●" Width="14" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                    <TextBlock.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqualityToVisibility}">
                                                            <Binding/>
                                                            <Binding Path="PlacementTarget.DataContext.ActiveTab" RelativeSource="{RelativeSource AncestorType=Popup}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                                <Grid>
                                                    <TextBlock Text="{Binding Project.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                    <TextBox x:Name="RenameBox" Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"
                                                             SpellCheck.IsEnabled="False"
                                                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <Button Content="Preview &amp; Copy Prompt" Padding="12,4" Margin="20,0,0,0"
                        Background="#3B6EA5" Foreground="White" FontWeight="Bold"
                        Click="Preview_Click"/>
                <Button Content="Export ComfyUI Workflow..." Padding="12,4" Margin="8,0,0,0"
                        Background="#4A7A4A" Foreground="White" FontWeight="Bold"
                        Command="{Binding ExportComfyWorkflowCommand}"/>
                <Button Content="Import ComfyUI Workflow..." Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding ImportComfyWorkflowCommand}"
                        ToolTip="Reconstruct a project from a workflow this tool previously exported. Opens as a new, unsaved project -- best-effort, since it reads the prompt text and node titles back rather than a dedicated round-trip format."/>
                <Button Content="Import Prompt Text..." Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding ImportPromptTextCommand}"
                        ToolTip="Paste a six-section MiniMax H3 prompt drafted elsewhere and build a new project from it: a subject per &lt;Subject N&gt;, an empty slot per &lt;Picture N&gt;/&lt;Audio N&gt;, and spoken &lt;d&gt; lines as structured dialogue. Opens as a new, unsaved project."/>
                <Button Content="Settings..." Padding="10,4" Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Cast & Setting -->
            <DockPanel Grid.Column="0" Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Cast &amp; Setting" FontWeight="Bold" FontSize="14"/>
                    <Button x:Name="AddSubjectButton" DockPanel.Dock="Right" Content="+ Add ▾" Padding="8,2" HorizontalAlignment="Right"
                            Click="AddSubjectButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Blank Subject" Command="{Binding AddSubjectCommand}"/>
                                <Separator/>
                                <MenuItem Header="Pod">
                                    <MenuItem Header="Create New Character Pod..." Command="{Binding CreateCharacterPodCommand}"/>
                                    <MenuItem Header="Edit Existing Pod..." Command="{Binding EditCharacterPodCommand}"/>
                                    <MenuItem Header="Load Existing Pod..." Command="{Binding LoadCharacterPodCommand}"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Project.Subjects}" AlternationCount="1000000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Subject}">
                                <views:SubjectEditor DisplayNumber="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                      Path=(ItemsControl.AlternationIndex),
                                                      Converter={StaticResource IndexPlusOne}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

            <!-- Shots -->
            <DockPanel Grid.Column="2" Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+ Segment" Padding="8,2" Margin="6,0,0,0"
                            Command="{Binding AddSegmentCommand}"
                            ToolTip="Add another clip that continues from the end of the last one. The cast (pictures, voices) is shared -- set once, used by every segment. Exports as one ComfyUI workflow that generates the clips back to back."/>
                    <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2" Margin="6,0,0,0"
                            Command="{Binding RemoveCurrentSegmentCommand}"
                            Visibility="{Binding IsContinuationSegment, Converter={StaticResource BoolToVis}}"
                            ToolTip="Remove the selected continuation segment"/>
                    <ListBox ItemsSource="{Binding SegmentLabels}" SelectedIndex="{Binding CurrentSegmentIndex, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,3"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Shots" FontWeight="Bold" FontSize="14"/>
                    <Button DockPanel.Dock="Right" Content="+ Add Shot" Padding="8,2" HorizontalAlignment="Right"
                            Command="{Binding AddShotCommand}"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CurrentShots}" AlternationCount="1000000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Shot}">
                                <views:ShotCard AllSubjects="{Binding DataContext.Project.Subjects,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                 SourceVideos="{Binding DataContext.CurrentVideos,
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                 DisplayNumber="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                 Path=(ItemsControl.AlternationIndex),
                                                 Converter={StaticResource IndexPlusOne}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

            <!-- Scene fields -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Margin="8">
                <StackPanel>
                    <TextBlock Text="Task Type" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <CheckBox Content="keyframe completion" IsChecked="{Binding TaskKeyframeCompletion}" Margin="0,2"/>
                    <CheckBox Content="reference generation" IsChecked="{Binding TaskReferenceGeneration}" Margin="0,2"/>
                    <CheckBox Content="video editing" IsChecked="{Binding TaskVideoEditing}" Margin="0,2"/>
                    <CheckBox Content="video continuation" IsChecked="{Binding TaskVideoContinuation}" Margin="0,2" IsEnabled="{Binding IsNotContinuationSegment}"/>
                    <CheckBox Content="audio reuse" IsChecked="{Binding TaskAudioReuse}" Margin="0,2" IsEnabled="{Binding IsNotContinuationSegment}"/>
                    <CheckBox Content="audio reference" IsChecked="{Binding TaskAudioReference}" Margin="0,2" IsEnabled="{Binding IsNotContinuationSegment}"/>

                    <CheckBox Content="also save one joined video" Margin="0,8,0,0"
                              IsChecked="{Binding Project.SaveJoinedVideo}"
                              Visibility="{Binding HasMultipleSegments, Converter={StaticResource BoolToVis}}"
                              ToolTip="Adds nodes that join every clip -- frames and audio -- into one extra video, saved next to the individual clips. Each pinned-ending clip contributes only its new material, so the pieces butt together."/>

                    <CheckBox Content="keep pinned frames in each clip (to check the handoff)" Margin="0,4,0,0"
                              IsChecked="{Binding Project.KeepPinnedFrames}"
                              Visibility="{Binding HasMultipleSegments, Converter={StaticResource BoolToVis}}"
                              ToolTip="Diagnostic. Normally the previous clip's pinned ending is cut from the start of each continuation's saved file. Turn this on to keep it, then compare the opening of that clip with the previous clip's ending: if they match, the pin held and any hard cut comes from the new content (usually the prompt); if not, the pin isn't holding. The joined video will repeat the pinned span while this is on."/>

                    <TextBlock Text="{Binding SegmentWarnings}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasSegmentWarnings, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Duration (seconds)" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Text="{Binding CurrentSegment.DurationSeconds, StringFormat='{}{0:0.0}s'}"/>
                        <Slider Minimum="1" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Value="{Binding CurrentSegment.DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="Aspect Ratio" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <ComboBox ItemsSource="{x:Static local:EnumSources.AspectRatioChoices}"
                              SelectedItem="{Binding Project.AspectRatio}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Megapixels" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Text="{Binding Project.Megapixels, StringFormat='{}{0:0.00} MP'}"/>
                        <Slider Minimum="0.1" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Project.Megapixels, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="Visual Style" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <ComboBox ItemsSource="{x:Static local:EnumSources.VisualStyleChoices}"
                              SelectedItem="{Binding Project.VisualStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Summary" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <TextBlock Text="Insert reference:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2"/>
                    <ItemsControl x:Name="SummaryChipsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding TagText}" Click="SummaryChip_Click"
                                        Margin="0,0,4,4" Padding="6,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <TextBox x:Name="SummaryTextBox" Text="{Binding CurrentSegment.Summary, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSegment.Summary, Converter={StaticResource BlankStringToVisibility}}" Value="Visible">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.ToolTip>
                                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                           Text="One or two sentences naming the task type and how the references relate to each other.&#10;Example: &quot;Reference generation combining &lt;Subject 1&gt; from &lt;Picture 1&gt; with &lt;Subject 2&gt;'s café setting; &lt;Audio 1&gt; guides the voice.&quot;"/>
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Text="Task type + how references relate, e.g. &quot;Reference generation combining &lt;Subject 1&gt; and &lt;Subject 2&gt;'s setting.&quot;"
                                   Style="{StaticResource PlaceholderOverlayStyle}"
                                   Visibility="{Binding CurrentSegment.Summary, Converter={StaticResource BlankStringToVisibility}}"/>
                    </Grid>
                    <TextBlock Text="No summary text -- this section will be left out of the export entirely."
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding CurrentSegment.Summary, Converter={StaticResource BlankStringToVisibility}}"/>

                    <TextBlock Text="Overall Soundscape" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <Grid>
                        <TextBox Text="{Binding CurrentSegment.OverallSoundscape, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto">
                            <TextBox.ToolTip>
                                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                           Text="1-4 sentences of ambient and physical-action sound -- never dialogue or singing.&#10;Example: &quot;Steady rain taps against the café windows while low room ambience continues underneath.&quot;"/>
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Text="Ambient &amp; physical sounds (no dialogue), e.g. &quot;Steady rain taps the windows; low room ambience underneath.&quot;"
                                   Style="{StaticResource PlaceholderOverlayStyle}"
                                   Visibility="{Binding CurrentSegment.OverallSoundscape, Converter={StaticResource BlankStringToVisibility}}"/>
                    </Grid>

                    <TextBlock Text="Non-Diegetic Music" FontWeight="Bold" FontSize="14" Margin="0,16,0,6"/>
                    <Grid>
                        <TextBox Text="{Binding CurrentSegment.NonDiegeticMusic, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto">
                            <TextBox.ToolTip>
                                <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                           Text="1-3 sentences of background music only the audience hears. Describe instrumentation and dynamics, not emotions -- avoid words like 'sad' or 'tense'.&#10;Example: &quot;A slow piano melody with soft string pads, gradually increasing in volume.&quot;"/>
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Text="Score the characters can't hear, e.g. &quot;Soft piano and strings swell gently.&quot;"
                                   Style="{StaticResource PlaceholderOverlayStyle}"
                                   Visibility="{Binding CurrentSegment.NonDiegeticMusic, Converter={StaticResource BlankStringToVisibility}}"/>
                    </Grid>

                    <DockPanel Margin="0,16,0,6">
                        <TextBlock Text="Source Videos" FontWeight="Bold" FontSize="14"/>
                        <Button DockPanel.Dock="Right" Content="+ Add" Padding="8,2" HorizontalAlignment="Right"
                                Command="{Binding AddSourceVideoCommand}"
                                Visibility="{Binding IsNotContinuationSegment, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <TextBlock Text="(only needed for video editing / continuation task types)"
                               FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding CurrentVideos}" AlternationCount="1000000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:VideoRef}">
                                <Border Margin="0,2,0,0" Padding="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"
                                                       Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                                      Path=(ItemsControl.AlternationIndex),
                                                                      Converter={StaticResource IndexPlusOne},
                                                                      StringFormat='&lt;Video {0}&gt;'}"/>
                                            <Button DockPanel.Dock="Right" Content="✕" Width="20" Padding="0"
                                                    Command="{Binding DataContext.RemoveSourceVideoCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding FromPreviousSegment, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </DockPanel>
                                        <Grid Margin="0,4,0,0">
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.ToolTip>
                                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                               Text="What this video is used for. Examples: &quot;the source video for the target video edit&quot;, &quot;a reference for its cut and pacing structure&quot;."/>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                            <TextBlock Text="What this video is used for" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Description, Converter={StaticResource BlankStringToVisibility}}"/>
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding FromPreviousSegment, Converter={StaticResource BoolToVis}}"
                                                   Text="The previous segment's finished clip -- fed straight from it inside the exported workflow, so there's no file to pick."/>
                                        <ComboBox Margin="0,4,0,0"
                                                  ItemsSource="{x:Static local:EnumSources.PreviousClipHandoffChoices}"
                                                  SelectedItem="{Binding Handoff}"
                                                  Visibility="{Binding FromPreviousSegment, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Pin its ending (recommended): the previous clip's last frames and sound are locked onto the first frames of this clip (MiniMaxH3AddGuide), so motion and audio carry across by construction. The pinned part is dropped from this clip's saved file, so the two files butt together. Reference video: hands it over as a &lt;Video 1&gt; the model may imitate -- and, if long, copy.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DockPanel Margin="0,4,0,0"
                                                   Visibility="{Binding FromPreviousSegment, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="How much of the previous clip is handed to this segment, counted back from its end. The ending motion and sound are what a continuation needs, and every reference frame costs extra memory and time on every sampling step -- a short tail is far cheaper than the whole clip. Snapped to a valid clip length, and never longer than this segment itself. 0 uses the whole previous clip.">
                                            <TextBlock Text="Use only the last" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Width="48" Margin="6,0,6,0" Text="{Binding UseLastSeconds, StringFormat=0.##}"/>
                                            <TextBlock Text="s  (pin / reference; 0 = whole clip)" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0" LastChildFill="True"
                                                   Visibility="{Binding FromPreviousSegment, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Button DockPanel.Dock="Left" Content="Browse..." Padding="6,2"
                                                    Command="{Binding DataContext.BrowseVideoFileCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}"
                                                       Text="{Binding FilePath, Converter={StaticResource PathToFileName}}"/>
                                        </DockPanel>
                                        <TextBlock Text="Its audio" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,2"
                                                   ToolTip="Feeds this video's own soundtrack to the reference node's paired ref_video_audios input and adds an &lt;Audio N&gt; for it. Reuse keeps the original audio audible; Continue (reference) lets new audio pick up its audible character -- the usual choice for continuing a clip."/>
                                        <ComboBox ItemsSource="{x:Static local:EnumSources.VideoAudioUseChoices}"
                                                  SelectedItem="{Binding AudioUse}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Retention" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,2"/>
                                        <ComboBox ItemsSource="{x:Static local:EnumSources.VisualRetentionChoices}"
                                                  SelectedItem="{Binding Retention}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid Margin="0,4,0,0">
                                            <TextBox Text="{Binding RetentionNote, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.ToolTip>
                                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                               Text="What's kept vs. changed from this source video. Levels: fully_preserved, partially_preserved, attribute_transfer, weak_reference.&#10;Example: &quot;partially_preserved -- keeps the cut rhythm and camera framing, but the setting changes to a rooftop.&quot;"/>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                            <TextBlock Text="What's preserved, e.g. &quot;cut rhythm and framing only&quot;" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding RetentionNote, Converter={StaticResource BlankStringToVisibility}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
