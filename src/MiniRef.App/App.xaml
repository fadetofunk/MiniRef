<Application x:Class="MiniRef.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniRef.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="PanelFg" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#454545"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="4"/>
            <!-- On by default since most text boxes in this app are free-form prose (shot
                 narrative, descriptions, retention notes). The handful that hold names, file
                 paths, or codes instead turn this back off locally. -->
            <Setter Property="SpellCheck.IsEnabled" Value="True"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- The dropdown popup renders on its own white surface regardless of the ComboBox's
             own dark theme, so its items need an explicit light background / dark text or the
             inherited light Foreground becomes illegible on that white popup. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#CCE4FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B4D6FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource PanelFg}"/>
        </Style>

        <!-- Same issue as the ComboBox dropdown: WPF's default ToolTip chrome picks up the OS
             dark-mode text color while its background stays whatever the system theme renders,
             which can make every field hint illegible. A plain Foreground Setter here isn't
             enough: ToolTip wraps a plain string Content in an implicit TextBlock, and the
             global TextBlock style above wins over that inherited Foreground (style Setters
             always beat inheritance), so the text rendered light gray again. ContentTemplate
             sets Foreground as a literal local value on that TextBlock instead, which nothing
             else can override. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" TextWrapping="Wrap" MaxWidth="320"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
