<UserControl x:Class="MiniRef.App.Views.SubjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:MiniRef.App.Converters"
             xmlns:views="clr-namespace:MiniRef.App.Views"
             mc:Ignorable="d" x:Name="Root"
             d:DesignWidth="300">
    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Width="20" Padding="0" Margin="0,0,6,0"
                        Click="ToggleExpand_Click" ToolTip="Expand/collapse card">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Content" Value="▼"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="{Binding DisplayNumber, ElementName=Root, StringFormat='&lt;Subject {0}&gt;'}"/>
                <Button DockPanel.Dock="Right" Content="✕" Width="22" Padding="0"
                        Click="Remove_Click" ToolTip="Remove"/>
                <Button DockPanel.Dock="Right" Content="↓" Width="22" Padding="0" Margin="0,0,4,0"
                        Click="MoveDown_Click" ToolTip="Move down"/>
                <Button DockPanel.Dock="Right" Content="↑" Width="22" Padding="0" Margin="0,0,4,0"
                        Click="MoveUp_Click" ToolTip="Move up"/>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="{Binding Name}"/>
            </DockPanel>

            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Button Content="Replace with Pod..." HorizontalAlignment="Left" Margin="0,2,0,0"
                        Click="ReplaceWithPod_Click"
                        ToolTip="Overwrite this subject's name, appearance, pictures, and voice references from a Character Pod, keeping its &lt;Subject N&gt; number and every tag that uses it."/>
                <views:SubjectFieldsEditor/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
