<Window x:Class="MiniRef.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MiniRef.App.Converters"
        Title="Settings" Height="660" Width="620"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <conv:BlankStringToVisibilityConverter x:Key="BlankStringToVisibility"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <Border x:Name="WelcomeBanner" Background="#2A3B4D" CornerRadius="4" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="#CFE3F7"
                           Text="Welcome! Point this at your ComfyUI install so exported workflows and copied reference files land in the right place. You can skip this and set it up later from Settings."/>
            </Border>

            <TextBlock Text="ComfyUI root folder" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,8"
                       Text="e.g. C:\ComfyUI -- workflows export to '{root}\user\default\workflows' and picture/audio files copy into '{root}\input' automatically."/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse..." Padding="10,4" Margin="6,0,0,0" Click="Browse_Click"/>
                <Grid>
                    <TextBox x:Name="RootFolderTextBox" VerticalContentAlignment="Center" SpellCheck.IsEnabled="False" TextChanged="RootFolderTextBox_TextChanged"/>
                    <TextBlock Text="C:\ComfyUI" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=RootFolderTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <TextBlock x:Name="RootValidationText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Workflow Models" FontWeight="Bold" FontSize="14" Margin="0,20,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,8"
                       Text="Overrides which model file each loader node in the exported workflow uses. Once the root folder above is set, Browse opens right in the matching models subfolder. Leave blank to keep the bundled default."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Click="Cancel_Click"/>
            <Button Content="Save" Padding="14,5" Margin="8,0,0,0"
                    Background="#3B6EA5" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NoTemplateText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontStyle="Italic" Visibility="Collapsed"
                           Text="Bundled ComfyUI template not found -- model overrides unavailable."/>
                <ItemsControl x:Name="ModelRowsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,0" Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding DefaultFilename, StringFormat='bundled default: {0}'}"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0"
                                                Click="BrowseModel_Click"/>
                                        <Grid>
                                            <TextBox Text="{Binding OverrideFilename, UpdateSourceTrigger=PropertyChanged}"
                                                     SpellCheck.IsEnabled="False"/>
                                            <TextBlock Text="Leave blank to keep the bundled default" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding OverrideFilename, Converter={StaticResource BlankStringToVisibility}}"/>
                                        </Grid>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
