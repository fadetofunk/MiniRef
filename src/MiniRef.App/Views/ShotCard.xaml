<UserControl x:Class="MiniRef.App.Views.ShotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:MiniRef.App.Converters"
             xmlns:app="clr-namespace:MiniRef.App"
             mc:Ignorable="d" x:Name="Root"
             d:DesignWidth="480">
    <UserControl.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:BlankStringToVisibilityConverter x:Key="BlankStringToVisibility"/>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                           Text="{Binding DisplayNumber, ElementName=Root, StringFormat='[Shot {0}]'}"/>
                <Grid DockPanel.Dock="Left" Width="110" Margin="10,0,0,0">
                    <TextBox x:Name="TimestampBox" SpellCheck.IsEnabled="False"
                             Background="White" Foreground="Black" CaretBrush="Black"
                             Text="{Binding Timestamp, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Timestamp, e.g. 00:03.500 (optional)"/>
                    <TextBlock Text="timestamp" Foreground="Black" Margin="7,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=TimestampBox}" Value=""/>
                                            <Condition Binding="{Binding IsFocused, ElementName=TimestampBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button DockPanel.Dock="Right" Content="✕" Width="22" Padding="0" Click="Remove_Click" ToolTip="Remove shot"/>
                <Button DockPanel.Dock="Right" Content="↓" Width="22" Padding="0" Margin="0,0,4,0" Click="MoveDown_Click" ToolTip="Move down"/>
                <Button DockPanel.Dock="Right" Content="↑" Width="22" Padding="0" Margin="0,0,4,0" Click="MoveUp_Click" ToolTip="Move up"/>
            </DockPanel>

            <TextBlock Text="Insert reference:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding Chips, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Tag="{Binding TagText}" Click="Chip_Click"
                                Margin="0,0,4,4" Padding="6,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <RichTextBox x:Name="ShotTextBox" MinHeight="90"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsTab="False"
                             TextChanged="ShotTextBox_TextChanged"
                             PreviewKeyDown="ShotTextBox_PreviewKeyDown"
                             DataObject.Pasting="ShotTextBox_Pasting">
                    <RichTextBox.ToolTip>
                        <TextBlock MaxWidth="380" TextWrapping="Wrap"
                                   Text="Shot narrative in playback order: action, camera movement, sound, dialogue. Click a chip above (or type &lt;Subject N&gt; / &lt;Picture N&gt; / &lt;Audio N&gt; / &lt;Video N&gt;) to reference something.&#10;&#10;Camera: motion + amplitude + speed, e.g. &quot;The camera pushes in with small amplitude at slow speed toward the folded letter.&quot;&#10;&#10;Dialogue: use the Dialogue line tool below, which inserts &quot;&lt;Subject N&gt; (S1) says, &lt;d&gt;[English] text&lt;/d&gt;&quot; for you.&#10;&#10;On-screen text: quoted verbatim, e.g. a sign reading &quot;OPEN&quot;."/>
                    </RichTextBox.ToolTip>
                </RichTextBox>
                <TextBlock Text="Action, camera, sound, and dialogue, in the order they happen. Insert references with the chips above."
                           IsHitTestVisible="False" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.65"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,6,8,0" VerticalAlignment="Top"
                           Visibility="{Binding Text, Converter={StaticResource BlankStringToVisibility}}"/>
            </Grid>

            <Expander Header="Camera motion" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="MotionCombo" Width="130"
                              ItemsSource="{x:Static app:EnumSources.CameraMotionChoices}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="AmplitudeCombo" Width="90" Margin="4,0,0,0"
                              ItemsSource="{x:Static app:EnumSources.CameraAmplitudeChoices}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="SpeedCombo" Width="80" Margin="4,0,0,0"
                              ItemsSource="{x:Static app:EnumSources.CameraSpeedChoices}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Insert" Margin="6,0,0,0" Click="InsertMotion_Click"/>
                </StackPanel>
            </Expander>

            <Expander Header="Dialogue line" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <StackPanel Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SpeakerCombo" Width="130"
                                  ItemsSource="{Binding AllSubjects, ElementName=Root}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="LanguageBox" Width="80" Margin="4,0,0,0" Text="English" SpellCheck.IsEnabled="False"
                                 ToolTip="Language of the dialogue line, e.g. English, Mandarin. Kept as-is inside the &lt;d&gt;[language] ...&lt;/d&gt; tag."/>
                        <CheckBox x:Name="SilentCheckBox" Content="Silent" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Checked="SilentCheckBox_CheckedChanged" Unchecked="SilentCheckBox_CheckedChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Grid Width="260">
                            <TextBox x:Name="DialogueTextBox">
                                <TextBox.ToolTip>
                                    <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                               Text="The words this speaker says. Gets wrapped as &lt;d&gt;[language] ...&lt;/d&gt; and inserted at the caret.&#10;Example: &quot;Last summer, I went to my grandfather's house.&quot;"/>
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock Text="Spoken line" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DialogueTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="Insert" Margin="6,0,0,0" Click="InsertDialogue_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="On-screen text" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Grid Width="260">
                        <TextBox x:Name="OnScreenTextBox">
                            <TextBox.ToolTip>
                                <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                           Text="Visible text in the shot -- signs, captions, labels. Gets inserted in quotes at the caret.&#10;Example: a neon sign reading &quot;OPEN&quot;."/>
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Text="On-screen text, e.g. &quot;OPEN&quot;" IsHitTestVisible="False" FontStyle="Italic" Opacity="0.65"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=OnScreenTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Insert" Margin="6,0,0,0" Click="InsertOnScreenText_Click"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
