<Window x:Class="MiniRef.App.Views.ImportPromptTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Prompt Text" Height="560" Width="720"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,5" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Import" Padding="14,5" Margin="8,0,0,0"
                    Background="#3B6EA5" Foreground="White" FontWeight="Bold" Click="Import_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Paste a full six-section MiniMax H3 prompt (subject_definitions, summary, retention_analysis, detailed_description, overall_soundscape, non_diegetic_music). Headers may be written on their own line or as &quot;name: ...&quot;. A subject is created for every &lt;Subject N&gt;, with an empty slot for each &lt;Picture N&gt;/&lt;Audio N&gt; it names; spoken &lt;d&gt; lines become structured dialogue. Opens as a new project."/>
        <TextBox x:Name="PromptTextBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" SpellCheck.IsEnabled="False"/>
    </DockPanel>
</Window>
