<Window x:Class="MiniRef.App.Views.CharacterPodEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiniRef.App.Views"
        Title="Character Pod" Height="700" Width="420"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="14,5" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" Padding="14,5" Margin="8,0,0,0"
                    Background="#3B6EA5" Foreground="White" FontWeight="Bold" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <views:SubjectFieldsEditor/>
        </ScrollViewer>
    </DockPanel>
</Window>
