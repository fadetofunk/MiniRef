<Window x:Class="MiniRef.App.Views.PromptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Composed Prompt" Height="700" Width="640"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Padding="10,4" Click="Refresh_Click"/>
            <Button Content="Copy to Clipboard" Padding="10,4" Margin="8,0,0,0" Click="Copy_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </StackPanel>
        <TextBox x:Name="PromptTextBox" IsReadOnly="True" SpellCheck.IsEnabled="False" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                 Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0"/>
    </DockPanel>
</Window>
